{
    "module": "pysindy.feature_library",
    "class_name": "GeneralizedLibrary",
    "kwargs": {
        "libraries": [
            {
                "module": "pysindy.feature_library.polynomial_library",
                "class_name": "PolynomialLibrary",
                "kwargs": {
                    "degree": 3,
                    "include_bias": true
                }
            },
            {
                "module": "pysindy.feature_library.fourier_library",
                "class_name": "FourierLibrary",
                "kwargs": {
                    "n_frequencies": 1,
                    "include_sin": true,
                    "include_cos": true
                }
            }
        ]
    }
}